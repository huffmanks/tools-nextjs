{
  "name": "stratools",
  "version": "0.2.0",
  "author": {
    "name": "Kevin Huffman",
    "email": "huffmanks2@gmail.com",
    "url": "https://tools.huffmanks.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV='development' next dev --webpack -p 3011 -H 0.0.0.0",
    "build": "cross-env NODE_ENV='production' next build --webpack",
    "build:staging": "cross-env NODE_ENV='production' STAGING='true' next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.mjs",
    "preview": "cross-env NODE_ENV='development' pnpm dlx serve out -l 3012",
    "check": "next typegen --webpack && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen": "node scripts/gen-dummy-data.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@serwist/next": "^9.5.13",
    "change-case": "^5.4.4",
    "colord": "^2.10.0",
    "convert": "^8.0.2",
    "easyqrcodejs": "^4.6.2",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "fast-xml-validator": "^1.4.2",
    "js-yaml": "^5.5.0",
    "next": "16.4.3",
    "next-sitemap": "^4.2.3",
    "react": "19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "smol-toml": "^1.9.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "serwist": "^9.5.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
